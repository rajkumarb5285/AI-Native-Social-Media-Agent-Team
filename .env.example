APP_NAME=Nexus Studio - Autonomous Social Media Operations
ENVIRONMENT=development
DATABASE_PATH=./agent_runs.db

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (OIDC) Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# Session & Token Security
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-random-32-byte-hex-string-for-cookie-signing
JWT_SECRET=replace-with-a-long-random-secret-for-jwt-tokens
SECRET_ENCRYPTION_KEY=replace-with-a-different-long-random-secret-before-deploy

# Application URLs (Strict CORS & Allowed Redirects)
FRONTEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Social Platforms OAuth 2.0 Credentials (Separate incremental authorization)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# Trend & Live Research
TAVILY_API_KEY=
ENABLE_LIVE_SEARCH=false
