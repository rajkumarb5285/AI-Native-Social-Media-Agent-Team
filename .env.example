APP_NAME=AI Native Social Agent Team
ENVIRONMENT=development
DATABASE_PATH=./agent_runs.db

# LLM Provider Configuration (Optional; runs in transparent demo mode if omitted)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45

# Security & Encryption
JWT_SECRET=super-secret-production-signing-key-change-me
SECRET_ENCRYPTION_KEY=production-encryption-salt-32-chars-min

# Official Social Integrations (OAuth 2.0 Credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Live Trend & Market Research Integration
TAVILY_API_KEY=
