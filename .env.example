APP_NAME=AI Native Social Agent Team
ENVIRONMENT=development
DATABASE_PATH=./agent_runs.db

# LLM Provider Configuration (Optional; runs in transparent demo mode if omitted)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45

# Security & Encryption
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
SECRET_ENCRYPTION_KEY=replace-with-a-different-long-random-secret-before-deploy

# Official Social Integrations (OAuth 2.0 Credentials)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Live Trend & Market Research Integration
TAVILY_API_KEY=

# Public HTTPS URL of deployed FastAPI backend for OAuth callbacks
PUBLIC_BASE_URL=https://your-api.example.com

# Enable real search-backed research (requires TAVILY_API_KEY)
ENABLE_LIVE_SEARCH=false
TAVILY_API_KEY=

# LinkedIn versioned REST API header, verify active version in developer portal
LINKEDIN_API_VERSION=202601
